  "docs": { "url": "https://github.com/Cuelith/plugin-songs#readme" },
  "onboarding": [
    { "title": "cuelith.songs.onboarding.1.title", "body": "cuelith.songs.onboarding.1.body" },
    { "title": "cuelith.songs.onboarding.2.title", "body": "cuelith.songs.onboarding.2.body" },
    { "title": "cuelith.songs.onboarding.3.title", "body": "cuelith.songs.onboarding.3.body" }
  ]
}
