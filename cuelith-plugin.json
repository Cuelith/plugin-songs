{
  "$schema": "https://cuelith.github.io/cuelith-sdk/schema/plugin-1.json",
  "id": "cuelith.songs",
  "name": "Canti",
  "description": "Canti con strofe, ritornelli e ordine di proiezione. Importa ed esporta OpenLyrics e ChordPro.",
  "version": "0.4.0",
  "publisher": "Cuelith",
  "license": "Apache-2.0",
  "repository": "https://github.com/Cuelith/plugin-songs",
  "family": "function",
  "icon": "icon.svg",
  "engines": { "cuelith": "^0.1.0", "protocol": "^1.6.0" },
  "runtime": { "type": "none" },
  "ui": { "entry": "ui/index.html" },
  "permissions": [],
  "dependencies": {},
  "extends": [],
  "provides": [],
